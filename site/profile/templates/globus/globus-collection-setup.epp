#!/bin/sh
export GCS_CLI_ENDPOINT_ID=$(jq .endpoint_id -r /var/lib/globus-connect-server/info.json)
GATEWAY_ID=$(jq -r .id /var/lib/globus-connect-server/gateway.json)
COLLECTION_OUTPUT=$(
  globus-connect-server \
  -F json \
  --use-explicit-host \
  <%= $public_ip %>  \
  collection create ${GATEWAY_ID} \
  <%= $collection_path %> \
  --default-directory <%= $default_directory %> \
  "<%= $display_name %> collection"
)
exit_code=$?
if [ "${exit_code}" -eq 0 ]; then
  echo "${COLLECTION_OUTPUT}" > /var/lib/globus-connect-server/collection.json
else
  echo "${COLLECTION_OUTPUT}" > /var/lib/globus-connect-server/collection-error.json
  exit ${exit_code}
fi
