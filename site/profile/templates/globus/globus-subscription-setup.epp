#!/bin/sh
export GCS_CLI_ENDPOINT_ID=$(jq .endpoint_id -r /var/lib/globus-connect-server/info.json)
SUBSCRIPTION_OUTPUT=$(
  globus-connect-server endpoint update \
  --subscription-id <%= $subscription_id %> 2>&1
)
exit_code=$?
if [ "${exit_code}" -eq 0 ]; then
  jq -n --arg subscription_id "<%= $subscription_id %>" '{subscription_id: $subscription_id}' \
    > /var/lib/globus-connect-server/subscription.json
  rm -f /var/lib/globus-connect-server/subscription-error.json
else
  echo "${SUBSCRIPTION_OUTPUT}" > /var/lib/globus-connect-server/subscription-error.json
  exit ${exit_code}
fi
