#!/bin/bash

# mkproject.sh watches 389-ds access log for operations related to group
# matching a regex ($PROJECT_REGEX) with the intent of automatically
# manipulating Slurm accounts and folders under /project associated with these
# groups.

# Three operations are currently supported: ADD, MOD and DEL.
# - ADD triggers a creation of Slurm account and directory under /project
# - MOD triggers either the additions of users to the associated Slurm
#   accounts and their folder under /project/GID/`username`
#   or it triggers the removals of the users from the associated Slurm account
#   and the removal of the symlink from the users home to the project folder.
# - DEL trigger the removal of all users from the associated Slurm account
#   and the removal of the symlink to the project from all previous member
#   home folders.

# IPA membership workflow observed in 389-ds access logs
# IPA VERSION: 4.13.4, API_VERSION: 2.257
#
# Adding user01-user05 to def-sponsor01, connection 3233:
#   op=2,4,6,8,10: SRCH base="uid=<user>,cn=users,..." attrs="distinguishedName"
#   op=3,5,7,9,11: MOD dn="cn=def-sponsor01,cn=groups,..."
#   Each MOD returned RESULT err=0; op=15 was UNBIND.
#
# Removing those users, connection 3237:
#   op=1-5: MOD dn="cn=def-sponsor01,cn=groups,..."
#   Each MOD returned RESULT err=0; op=10 was UNBIND.
#   No SRCH base="uid=..." occurred on this connection.
#
# This observed distinction is the basis for the current heuristic:
#   user searches present -> pass those users to the addition path;
#   no user searches      -> reconcile removals against LDAP membership.
# Searches on other connections are excluded.
#
# Source-code basis:
# - LDAPAddMember.execute() loops over members using the same LDAP backend.
#   add_entry_to_group() calls get_entry() to check that the member exists,
#   then issues modify_s() with MOD_ADD on the group's member attribute.
# - LDAPRemoveMember.execute() also loops over members, but
#   remove_entry_from_group() issues MOD_DELETE without that member lookup.

# These traces validate successful additions/removals through this IPA
# workflow, not every LDAP client or failure case. Groups are queued only
# after at least one matching MOD RESULT succeeds.

# Assumes standard IPA UI user-membership actions or CLI
# group-add-member/group-remove-member --users commands.
# Mixed add/remove batches and direct member attribute edits are unsupported.
#
# Usernames are inferred connection-wide. For multiple users in one group,
# failed or missing MOD results trigger a membership check before addition.


SLAPD_LOG_FILE="/var/log/dirsrv/slapd-<%= $ipa_realm %>/access"

PROJECT_REGEX="<%= $project_regex %>"
BASEDN=$(grep -o -P "basedn = \K(.*)" /etc/ipa/default.conf)
LDAP_URI=$(grep -o -P "ldap_uri = \K(.*)" /etc/ipa/default.conf)
WITH_FOLDER="<%= $manage_folder %>"
PREV_CONN=""

source /sbin/account_functions.sh

MKHOME_PROJECT_DIR="/var/lib/mkhome_project/"
mkdir -p ${MKHOME_PROJECT_DIR}

MODPROJECT_CACHE=${MKHOME_PROJECT_DIR}/modproject.cache
MODPROJECT_CACHE_SIZE=1000

MKPROJECT_CACHE=${MKHOME_PROJECT_DIR}/mkproject.cache
MKPROJECT_CACHE_SIZE=1000
MKPROJECT_CACHE_LOCK=${MKHOME_PROJECT_DIR}/mkproject.cache.lock
update_mkproject_cache () {
    flock ${MKPROJECT_CACHE_LOCK} -c "echo ${1} >> ${MKPROJECT_CACHE} && (test \$(wc -l < ${MKPROJECT_CACHE}) -le ${MKPROJECT_CACHE_SIZE} || sed -i '1d' ${MKPROJECT_CACHE})"
}

LAST_TIMESTAMP_FILE=${MKHOME_PROJECT_DIR}/mkproject.last_timestamp

# FIFO pipes could eventually be replaced by sockets
# to allow input from other instances, like login nodes
# and avoid background echo processes. A FIFO pipe can
# be replaced by a UNIX socket with netcat and this command:
#   nc -lkU /var/tmp/dsocket
# To write data to the UNIX socket:
#   echo $((NRETRY+1)) "${GROUP}" "${WITH_FOLDER}" "${USERNAMES}" | nc -N -U /var/tmp/dsocket
MODPROJECT_PIPE=${MKHOME_PROJECT_DIR}/modproject.pipe
MODPROJECT_RETRY_PIPE=${MKHOME_PROJECT_DIR}/modproject_retry.pipe
MKHOME_MODPROJECT_PIPE=${MKHOME_PROJECT_DIR}/mkhome_modproject.pipe

trap "rm -f ${MODPROJECT_PIPE} ${MODPROJECT_RETRY_PIPE} ${MODPROJECT_CACHE} ${MKPROJECT_CACHE}" EXIT

if [[ ! -p ${MODPROJECT_PIPE} ]]; then
    mkfifo -m=600 ${MODPROJECT_PIPE}
fi

if [[ ! -p ${MODPROJECT_RETRY_PIPE} ]]; then
    mkfifo -m=600 ${MODPROJECT_RETRY_PIPE}
fi

# Create two empty cache files that are only r+w by root
install -m 600 /dev/null ${MKPROJECT_CACHE}
install -m 600 /dev/null ${MODPROJECT_CACHE}

wait_for_slurm

CONSECUTIVE_FAILURES=0
# Loop over three sources of project modification
# 1. Modification coming from SLAPD log
# 2. Modification coming from mkhome daemon
# 3. Modification coming from the loop that have errored on a previous try.
(
    tail -n+1 -F ${MODPROJECT_PIPE} &
    tail -n+1 -F ${MODPROJECT_RETRY_PIPE} &
    tail -n+1 -F ${MKHOME_MODPROJECT_PIPE}
) |
while read NRETRY GROUP WITH_FOLDER VALIDATE_MEMBER USERNAMES; do
    if [[ ${CONSECUTIVE_FAILURES} -gt 0 ]] && [[ ${NRETRY} -gt 0 ]]; then
        # Back off before retrying either membership validation or modproject.
        sleep ${CONSECUTIVE_FAILURES}
    fi
    # Queue format: NRETRY GROUP WITH_FOLDER VALIDATE_MEMBER [USERNAMES...].
    # Preserve the candidate users across failed IPA lookups.
    if [[ "${VALIDATE_MEMBER}" == "true" ]]; then
        CANDIDATE_USERNAMES=${USERNAMES}
        if GROUP_MEMBERS=$(kexec ipa group-show "${GROUP}" --raw); then
            GROUP_MEMBERS=$(echo "${GROUP_MEMBERS}" | grep -oP 'uid=\K([^,]*)(?=,cn=users)')
            USERNAMES=$(
                for USERNAME in ${CANDIDATE_USERNAMES}; do
                    if grep -Fxq -- "${USERNAME}" <<< "${GROUP_MEMBERS}"; then
                        echo "${USERNAME}"
                    fi
                done
            )
            # Empty additions must never become removal reconciliation requests.
            if [[ -z "${USERNAMES}" ]]; then
                CONSECUTIVE_FAILURES=0
                continue
            fi
            VALIDATE_MEMBER=false
        else
            CONSECUTIVE_FAILURES=$((CONSECUTIVE_FAILURES+1))
            if [[ ${NRETRY} -lt 10 ]]; then
                echo $((NRETRY+1)) ${GROUP} ${WITH_FOLDER} true ${CANDIDATE_USERNAMES} > ${MODPROJECT_RETRY_PIPE} &
            else
                echo "ERROR::ipa group-show ${GROUP}: giving up membership validation after 10 attempts."
            fi
            continue
        fi
    fi
    if [[ ! -z "${USERNAMES}" ]]; then
        # Filter group+usernames that have been successfully modified
        # and that are still in cache.
        USERNAMES=$(
            for USERNAME in ${USERNAMES}; do
                if ! grep -Fxq "${GROUP} ${WITH_FOLDER} ${USERNAME}" ${MODPROJECT_CACHE}; then
                    echo ${USERNAME}
                fi
            done
        )
        if [[ -z "${USERNAMES}" ]]; then
            continue
        fi
    fi
    if [ -e "${MKHOME_PROJECT_DIR}/${GROUP}.slurm.failed" ]; then
        if mkproject ${GROUP} ${WITH_FOLDER} && USERNAMES=$(kexec ipa group-show ${GROUP} --raw); then
            # Identify usernames that are already member of the group - most likely through automembership
            USERNAMES=$(echo "${USERNAMES}" | grep -o -P "uid=\K(.*)(?=,cn=users)")
            rm "${MKHOME_PROJECT_DIR}/${GROUP}.slurm.failed"
            update_mkproject_cache ${GROUP}
            if [[ ! -z ${USERNAMES} ]]; then
                echo 0 ${GROUP} ${WITH_FOLDER} false ${USERNAMES} > ${MODPROJECT_PIPE} &
            fi
        else
            CONSECUTIVE_FAILURES=$(($CONSECUTIVE_FAILURES+1))
            echo $((NRETRY+1)) ${GROUP} ${WITH_FOLDER} ${VALIDATE_MEMBER} ${USERNAMES} > ${MODPROJECT_RETRY_PIPE} &
        fi
        continue
    fi
    modproject ${GROUP} ${WITH_FOLDER} ${USERNAMES}
    case $? in
        0)
            # modproject has been successful
            if [[ ! -z "${USERNAMES}" ]]; then
                # If usernames were determined from the logs, it means we added user to a group,
                # so we add all usernames individually with the group name to
                # the cache
                for USERNAME in ${USERNAMES}; do
                    echo "${GROUP}" "${WITH_FOLDER}" "${USERNAME}" >> ${MODPROJECT_CACHE}
                done
                # then we restrict the size of the cache to its maximum value
                # by keeping the N most recent element added.
                echo "$(tail -n ${MODPROJECT_CACHE_SIZE} ${MODPROJECT_CACHE})" > ${MODPROJECT_CACHE}
            elif [[ ! -z "${REMOVED_USERNAMES}" ]]; then
                # If the usernames were not found from the logs, it means we removed user
                # from the group. The variable $REMOVE_USERNAMES is configured by modproject and
                # contains all usernames that were successfully removed from the group $GROUP
                for USERNAME in ${REMOVED_USERNAMES}; do
                    sed -i "/^${GROUP} ${WITH_FOLDER} ${USERNAME}$/d" ${MODPROJECT_CACHE}
                done
                unset REMOVED_USERNAMES
            fi
            CONSECUTIVE_FAILURES=0
            ;;
        1)
            # modproject was not successul, but the arguments are valid, so we should try again
            # later. We increment the number of retry and add the arguments the retry pipeline.
            CONSECUTIVE_FAILURES=$(($CONSECUTIVE_FAILURES+1))
            if [[ ${NRETRY} -lt 10 ]]; then
                echo $((NRETRY+1)) ${GROUP} ${WITH_FOLDER} ${VALIDATE_MEMBER} ${USERNAMES} > ${MODPROJECT_RETRY_PIPE} &
            else
                echo "ERROR::modproject ${GROUP} ${WITH_FOLDER} ${USERNAMES}: giving up after 10 attempts."
            fi
            ;;
        *)
            # modproject was not successful and the return code indicates the function should not be
            # called again with these arguments (invalid arguments, do not retry).
            CONSECUTIVE_FAILURES=$(($CONSECUTIVE_FAILURES+1))
            ;;
    esac
done &

# Do not reprocess previous entries if we remember the last timestamp treated
if [ -e ${LAST_TIMESTAMP_FILE} ]; then
    LAST_TIMESTAMP=$(cat ${LAST_TIMESTAMP_FILE})
    if [ "${LAST_TIMESTAMP}" != "" ]; then
        # We don't expect more than one line matching the timestamp but if
        # it happens, we will replay from the first match.
        start_index=$(grep -m 1 -n -F "${LAST_TIMESTAMP}" ${SLAPD_LOG_FILE} | cut -d: -f1)
        start_index=$(($start_index+1))
    else
        start_index=1
    fi
else
    start_index=1
fi

tail -n +${start_index} -F ${SLAPD_LOG_FILE} |
grep --line-buffered -P "dn=\"cn=${PROJECT_REGEX},cn=groups" |
sed -u -r 's/^\[(.*) \+[0-9]{4}\] conn=([0-9]*) op=[0-9]* (\w+) dn="cn=(.*),cn=groups.*$/\1 \2 \3 \4/' |
while read TIMESTAMP CONN OP GROUP; do
    # An operation has been done on a group in LDAP
    # We have already completed this request
    if [[ "${PREV_CONN}" == "${CONN}" ]]; then
        echo "${TIMESTAMP}" > ${LAST_TIMESTAMP_FILE}
        continue
    fi

    # We wait for the operation $CONN to be completed.
    # Taken from StackExchange:
    # https://unix.stackexchange.com/questions/416150/make-tail-f-exit-on-a-broken-pipe
    {
        grep --line-buffered -q -m 1 "conn=${CONN} op=[0-9]* UNBIND";
        kill -s PIPE "$!";
    } < <(tail -n +0 -F ${SLAPD_LOG_FILE} 2> /dev/null)

    # We support three operations : ADD, MOD or DEL
    case ${OP} in
        ADD)
            if grep -Fxq "${GROUP}" ${MKPROJECT_CACHE}; then
                echo "${TIMESTAMP}" > ${LAST_TIMESTAMP_FILE}
                PREV_CONN="${CONN}"
                continue
            fi

            if mkproject ${GROUP} ${WITH_FOLDER} && USERNAMES=$(kexec ipa group-show ${GROUP} --raw); then
                update_mkproject_cache ${GROUP}
                # Identify usernames that are already member of the group - most likely through automembership
                USERNAMES=$(echo "${USERNAMES}" |  grep -o -P "uid=\K(.*)(?=,cn=users)")
                if [[ ! -z ${USERNAMES} ]]; then
                    echo 0 ${GROUP} ${WITH_FOLDER} false ${USERNAMES} > ${MODPROJECT_PIPE} &
                fi
            else
                touch "${MKHOME_PROJECT_DIR}/${GROUP}.slurm.failed"
                echo 1 "${GROUP}" "${WITH_FOLDER}" false > "${MODPROJECT_RETRY_PIPE}" &
            fi
            ;;
        MOD)
            # One or more groups have been modified
            # We grep the log for all successful search operation
            # during connection $CONN that contain a uid to identify the list
            # of users affected by the modification.
            USERNAMES=$(
                awk -v cur_conn="${CONN}" '
                {
                    split($3, conn, "=")
                    split($4, op , "=")
                    action = $5
                    split($6, err, "=")
                    split($7, tag, "=")
                    split($8, nentries, "=")
                }
                conn[2] == cur_conn && action == "SRCH" { search[op[2]] = $0 }
                conn[2] == cur_conn && action == "RESULT" && err[2] == "0" && nentries[2] == "1" && tag[2] == "101" { succeeded[op[2]] = 1 }
                END {
                    for (op_i in search)
                        if (succeeded[op_i] == 1)
                            print search[op_i]
                }
                ' ${SLAPD_LOG_FILE} | grep -oP "SRCH base=\"uid=\K(.*)(?=,cn=users)" | sort -u
            )
            # Match MOD requests and successful results by connection and operation.
            # Entries may be interleaved; missing or failed results do not qualify.
            MOD_RESULTS=$(
                awk -v cur_conn="${CONN}" '
                    {
                        split($3, conn, "=")
                        split($4, op , "=")
                        action = $5
                        split($6, err, "=")
                        split($7, tag, "=")
                    }
                    conn[2] == cur_conn && action == "MOD" { modifications[op[2]] = $0 }
                    conn[2] == cur_conn && action == "RESULT" && err[2] == "0" && tag[2] == "103" { succeeded[op[2]] = 1 }
                    END {
                        failed = 0
                        for (op_i in modifications)
                            if (op_i in succeeded)
                                print modifications[op_i]
                            else
                                failed++
                        exit(failed > 0)
                    }
                ' "${SLAPD_LOG_FILE}"
            )
            FAILED_MOD="${?}"
            MOD_GROUPS=$(echo "${MOD_RESULTS}" | grep -oP " MOD dn=\"cn=\K${PROJECT_REGEX}" | sort -u)
            USERNAME_COUNT=$(echo "${USERNAMES}" | awk 'NF' | wc -l)
            VALIDATE_MEMBER=false
            if [[ ${USERNAME_COUNT} -gt 1 && ${FAILED_MOD} -gt 0 ]]; then
                VALIDATE_MEMBER=true
            fi
            # We only support two cases:
            # - Multiple group are modified in regards to a single user
            # - A single group is modified in regards to multiple users
            GROUP_COUNT=$(echo "${MOD_GROUPS}" | wc -l)
            if ! [[ ${USERNAME_COUNT} -gt 1 && ${GROUP_COUNT} -gt 1 ]]; then
                # We assume that under the UI and CLI workflows, multiple distinct searched
                # usernames should correspond to the modification of a single group.
                # Any other scenario is currently not supported by our heuristic.
                for GROUP in ${MOD_GROUPS}; do
                    echo 0 ${GROUP} ${WITH_FOLDER} ${VALIDATE_MEMBER} ${USERNAMES} > ${MODPROJECT_PIPE} &
                done
            fi
            ;;
        DEL)
            delproject ${GROUP} ${WITH_FOLDER}
            ;;
        *)
            echo "Unknown operation ${OP}"
            ;;
    esac
    PREV_CONN="${CONN}"
    echo "${TIMESTAMP}" > ${LAST_TIMESTAMP_FILE}
done
